{
  "build": {
    "builder": "nixpacks",
    "buildCommand": "npm install",
    "nixpacks": {
      "packages": ["python3", "gcc", "g++"]
    }
  },
  "deploy": {
    "startCommand": "mkdir -p /app/persist/data/properties /app/persist/data/backups /app/persist/uploads && npm start",
    "restartPolicyType": "ON_FAILURE"
  }
}
